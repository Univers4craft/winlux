[Desktop Entry]
Type=Application
Name=Winlux
GenericName=Programme Windows
GenericName[en]=Windows program
GenericName[de]=Windows-Programm
GenericName[es]=Programa de Windows
Comment=Exécuter un programme Windows avec Winlux
