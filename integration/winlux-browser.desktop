[Desktop Entry]
Type=Application
Name=Navigateur
Name[en]=Browser
Name[de]=Browser
Name[es]=Navegador
GenericName=Navigateur web
GenericName[en]=Web browser
GenericName[de]=Webbrowser
GenericName[es]=Navegador web
Comment=Ouvre les pages web dans le navigateur par défaut
Comment[en]=Opens web pages in the default browser
Comment[de]=Öffnet Webseiten im Standardbrowser
Comment[es]=Abre las páginas web en el navegador predeterminado
Exec=/usr/bin/winlux-browser %U
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;
StartupNotify=true
