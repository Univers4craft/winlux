<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><raiseOnFocus>yes</raiseOnFocus></focus>
  <placement><policy>Smart</policy><center>yes</center><monitor>Mouse</monitor></placement>
  <theme><name>Winlux</name><titleLayout>NLIMC</titleLayout><keepBorder>yes</keepBorder>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight></font>
    <font place="InactiveWindow"><name>DejaVu Sans</name><size>10</size></font>
    <font place="MenuItem"><name>DejaVu Sans</name><size>10</size></font>
  </theme>
  <desktops><number>1</number><firstdesk>1</firstdesk><names><name>Bureau Winlux</name></names></desktops>
  <resize><drawContents>yes</drawContents><popupShow>Nonpixel</popupShow></resize>
  <keyboard>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="W-l"><action name="Execute"><command>winlux-lock now</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>winlux-shell-app explorer</command></action></keybind>
    <keybind key="W-Return"><action name="Execute"><command>winlux-terminal</command></action></keybind>
    <!-- Ctrl+Alt+T par openbox : actif dès l'apparition du bureau (par xfsettingsd, il ne
         répondait qu'un peu plus tard). -->
    <keybind key="C-A-t"><action name="Execute"><command>winlux-terminal</command></action></keybind>
    <keybind key="W-space"><action name="Execute"><command>winlux-start-menu</command></action></keybind>
    <keybind key="C-S-Escape"><action name="Execute"><command>winlux-shell-app taskmgr</command></action></keybind>
    <keybind key="W-a"><action name="Execute"><command>winlux-system-tools quick</command></action></keybind>
    <keybind key="W-n"><action name="Execute"><command>winlux-popup notifications</command></action></keybind>
    <keybind key="W-v"><action name="Execute"><command>winlux-clipboard show</command></action></keybind>
    <keybind key="W-period"><action name="Execute"><command>winlux-emoji</command></action></keybind>
    <keybind key="W-semicolon"><action name="Execute"><command>winlux-emoji</command></action></keybind>
    <keybind key="W-F10"><action name="ShowMenu"><menu>root-menu</menu></action></keybind>
    <!-- Ancrage comme Windows 11 (winlux-snap) : Windows + flèches enchaîne moitiés,
         quarts, agrandissement et taille d'avant ; Windows + Z ouvre les dispositions. -->
    <keybind key="W-Up"><action name="Execute"><command>winlux-snap key up</command></action></keybind>
    <keybind key="W-Down"><action name="Execute"><command>winlux-snap key down</command></action></keybind>
    <keybind key="W-Left"><action name="Execute"><command>winlux-snap key left</command></action></keybind>
    <keybind key="W-Right"><action name="Execute"><command>winlux-snap key right</command></action></keybind>
    <keybind key="W-z"><action name="Execute"><command>winlux-snap layouts</command></action></keybind>
    <!-- Bureaux virtuels et vue des tâches (winlux-taskview). -->
    <keybind key="W-Tab"><action name="Execute"><command>winlux-taskview</command></action></keybind>
    <keybind key="W-C-d"><action name="Execute"><command>winlux-taskview new</command></action></keybind>
    <keybind key="W-C-F4"><action name="Execute"><command>winlux-taskview close</command></action></keybind>
    <keybind key="W-C-Left"><action name="GoToDesktop"><to>left</to><wrap>no</wrap></action></keybind>
    <keybind key="W-C-Right"><action name="GoToDesktop"><to>right</to><wrap>no</wrap></action></keybind>
    <!-- Windows + Maj + flèche : fenêtre vers l'écran voisin. -->
    <keybind key="W-S-Left"><action name="MoveResizeTo"><monitor>prev</monitor></action></keybind>
    <keybind key="W-S-Right"><action name="MoveResizeTo"><monitor>next</monitor></action></keybind>
  </keyboard>
  <mouse><dragThreshold>4</dragThreshold><doubleClickTime>450</doubleClickTime>
    <context name="Titlebar">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="Frame"><mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind><mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="Client"><mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind></context>
    <context name="Close"><mousebind button="Left" action="Click"><action name="Close"/></mousebind></context>
    <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify"/></mousebind></context>
    <context name="Maximize"><mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind><mousebind button="Right" action="Click"><action name="Focus"/><action name="Execute"><command>winlux-snap layouts</command></action></mousebind></context>
    <context name="Bottom"><mousebind button="Left" action="Drag"><action name="Resize"><edge>bottom</edge></action></mousebind></context>
    <context name="BLCorner"><mousebind button="Left" action="Drag"><action name="Resize"><edge>bottomleft</edge></action></mousebind></context>
    <context name="BRCorner"><mousebind button="Left" action="Drag"><action name="Resize"><edge>bottomright</edge></action></mousebind></context>
    <context name="TLCorner"><mousebind button="Left" action="Drag"><action name="Resize"><edge>topleft</edge></action></mousebind></context>
    <context name="TRCorner"><mousebind button="Left" action="Drag"><action name="Resize"><edge>topright</edge></action></mousebind></context>
    <context name="Left"><mousebind button="Left" action="Drag"><action name="Resize"><edge>left</edge></action></mousebind></context>
    <context name="Right"><mousebind button="Left" action="Drag"><action name="Resize"><edge>right</edge></action></mousebind></context>
    <context name="Top"><mousebind button="Left" action="Drag"><action name="Resize"><edge>top</edge></action></mousebind></context>
    <!-- Bureau : xfdesktop affiche lui-même le menu d'un fichier (Ouvrir, Renommer,
         Supprimer…) ou de l'espace vide ; un clic lui donne le clavier (Ctrl+C/V, Suppr, F2). -->
    <context name="Desktop"><mousebind button="Left" action="Press"><action name="Focus"><desktop>yes</desktop></action></mousebind></context>
    <context name="Root"><mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind></context>
  </mouse>
  <menu><file>~/.config/openbox/menu.xml</file><hideDelay>200</hideDelay><applicationIcons>yes</applicationIcons></menu>
  <applications>
    <application type="normal"><maximized>no</maximized><fullscreen>no</fullscreen><focus>yes</focus></application>
  </applications>
</openbox_config>
