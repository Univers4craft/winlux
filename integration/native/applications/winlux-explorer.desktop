[Desktop Entry]
Type=Application
Name=Explorer Winlux
Comment=Parcourir les fichiers et logiciels Linux et Windows
Exec=/usr/bin/winlux-shell-app explorer %f
Icon=/usr/share/winlux/native/icons/explorer.svg
StartupWMClass=winlux-explorer
Terminal=false
Categories=System;FileManager;
MimeType=inode/directory;application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/gzip;application/x-xz;application/x-bzip2;application/zstd;application/vnd.ms-cab-compressed;
