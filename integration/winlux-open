#!/bin/sh
# Lanceur de double-clic pour les exécutables Windows.
#
# Appelé par winlux.desktop avec le chemin du fichier choisi dans le
# gestionnaire de fichiers. Les programmes console s'ouvrent dans un terminal
# qui reste ouvert à la fin; les programmes graphiques sont lancés directement.
# Les erreurs sont affichées dans une boîte de dialogue lorsque c'est possible.
set -u
umask 077

winlux=${WINLUX_RUNTIME:-winlux}
state=${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/winlux
log="$state/last-launch.log"

show_message() {
    title="Winlux"
    message=$1
    mode=${2:-error}
    dialog_flag=--error
    icon=dialog-error
    if [ "$mode" = info ]; then dialog_flag=--msgbox; icon=dialog-information; fi
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        # Détails techniques : repliés dans la boîte Winlux, ajoutés au texte
        # pour les autres boîtes.
        full=$message
        if [ -n "${3:-}" ]; then full="$message

${3:-}"; fi
        if command -v kdialog >/dev/null 2>&1; then
            kdialog --title "$title" "$dialog_flag" "$full" && return
        elif command -v zenity >/dev/null 2>&1; then
            zenity "--$mode" --title="$title" --no-wrap --text="$full" && return
        # Boîte Winlux (GTK) : texte en français lisible, détails techniques
        # repliés. xmessage affichait l'UTF-8 en charabia, titre « xmessage ».
        elif command -v python3 >/dev/null 2>&1 && gtk_message "$mode" "$message" "${3:-}"; then
            return
        elif command -v notify-send >/dev/null 2>&1; then
            notify-send --app-name=Winlux --icon="$icon" "$title" "$full" && return
        elif command -v xmessage >/dev/null 2>&1; then
            xmessage -center "$title : $full" && return
        fi
    fi
    printf 'Winlux : %s\n' "$message${3:+
$3}" >&2
}
show_error() { show_message "$1" error "${2:-}"; }

# Logiciel à anti-triche noyau (#1720) : le runtime a déjà expliqué le refus
# dans sa propre boîte, rien d'autre à afficher.
refused_by_anticheat() {
    grep -qF 'installation refusée (anti-triche noyau)' "$log" 2>/dev/null
}

gtk_message() {
    python3 - "$@" <<'PY' 2>/dev/null
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
mode, message, details = sys.argv[1], sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else ""
kind = Gtk.MessageType.INFO if mode == "info" else Gtk.MessageType.ERROR
dialog = Gtk.MessageDialog(message_type=kind, buttons=Gtk.ButtonsType.OK, text=message.split("\n", 1)[0])
dialog.set_title("Winlux")
if "\n" in message:
    dialog.format_secondary_text(message.split("\n", 1)[1])
if details.strip():
    expander = Gtk.Expander(label="Détails techniques")
    view = Gtk.Label(label=details.strip(), selectable=True, xalign=0, wrap=True, max_width_chars=70)
    expander.add(view)
    dialog.get_message_area().pack_end(expander, False, False, 0)
    expander.show_all()
dialog.set_keep_above(True)
dialog.run()
PY
}

# Paquet MSIX d'un éditeur non vérifié : « Annuler » par défaut, il faut
# choisir « Installer quand même ». Sans affichage ni boîte : refus.
confirm_unverified() {
    name=$1; reason=$2
    text="« $name » : éditeur non vérifié.

$reason"
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 1
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Éditeur non vérifié" --warningcontinuecancel "$text" --continue-label "Installer quand même"
        return
    elif command -v zenity >/dev/null 2>&1; then
        zenity --question --default-cancel --title="Éditeur non vérifié" \
            --ok-label="Installer quand même" --cancel-label="Annuler" --no-wrap --text="$text"
        return
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "$name" "$reason" <<'PY' 2>/dev/null
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
name, reason = sys.argv[1], sys.argv[2]
d = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.NONE,
                      text="« %s » : éditeur non vérifié" % name)
d.set_title("Éditeur non vérifié")
d.format_secondary_text(reason)
d.add_button("Annuler", Gtk.ResponseType.CANCEL)
d.add_button("Installer quand même", Gtk.ResponseType.ACCEPT)
d.set_default_response(Gtk.ResponseType.CANCEL)
d.set_keep_above(True)
sys.exit(0 if d.run() == Gtk.ResponseType.ACCEPT else 1)
PY
        return
    fi
    return 1
}

# Installeur web (#896) : il ne contient qu'un téléchargeur. Winlux propose
# de récupérer le paquet officiel complet, décrit par les lignes
# « download.* » du journal ; rien n'est téléchargé sans un « oui ».
# Question dans la langue de la session (fr, en, de, es).
confirm_download() {
    journal=$1
    field() { sed -n "s/^download\.$1=//p" "$journal" 2>/dev/null | head -n 1; }
    name=$(field name); version=$(field version); publisher=$(field publisher)
    source=$(field source); size=$(field size_mb)
    [ -n "$name" ] && [ -n "$source" ] || return 1
    lang=${LC_ALL:-${LC_MESSAGES:-${LANG:-fr}}}
    case "$lang" in
        en*) title="Download required"
             text="This installer only contains a downloader, which Winlux cannot run yet.

Winlux can download the official full package instead:
$name $version, published by $publisher
Source: $source ($size MB)

The file is checked (version and SHA-256 fingerprint) before installation."
             yes="Download and install"; no="Cancel" ;;
        de*) title="Download erforderlich"
             text="Dieses Installationsprogramm enthält nur einen Downloader, den Winlux noch nicht ausführen kann.

Winlux kann stattdessen das offizielle vollständige Paket herunterladen:
$name $version, veröffentlicht von $publisher
Quelle: $source ($size MB)

Die Datei wird vor der Installation geprüft (Version und SHA-256-Fingerabdruck)."
             yes="Herunterladen und installieren"; no="Abbrechen" ;;
        es*) title="Descarga necesaria"
             text="Este instalador solo contiene un programa de descarga que Winlux aún no puede ejecutar.

Winlux puede descargar en su lugar el paquete oficial completo:
$name $version, publicado por $publisher
Origen: $source ($size MB)

El archivo se comprueba (versión y huella SHA-256) antes de instalarlo."
             yes="Descargar e instalar"; no="Cancelar" ;;
        *)   title="Téléchargement nécessaire"
             text="Cet installeur ne contient qu’un téléchargeur, que Winlux ne sait pas encore exécuter.

Winlux peut récupérer à la place le paquet officiel complet :
$name $version, publié par $publisher
Source : $source ($size Mo)

Le fichier est vérifié (version et empreinte SHA-256) avant l’installation."
             yes="Télécharger et installer"; no="Annuler" ;;
    esac
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 1
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "$title" --warningcontinuecancel "$text" --continue-label "$yes" --cancel-label "$no"
        return
    elif command -v zenity >/dev/null 2>&1; then
        zenity --question --default-cancel --title="$title" \
            --ok-label="$yes" --cancel-label="$no" --no-wrap --text="$text"
        return
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "$title" "$text" "$yes" "$no" <<'PY' 2>/dev/null
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
title, text, yes, no = sys.argv[1:5]
d = Gtk.MessageDialog(message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                      text=title)
d.set_title(title)
d.format_secondary_text(text)
d.add_button(no, Gtk.ResponseType.CANCEL)
d.add_button(yes, Gtk.ResponseType.ACCEPT)
d.set_default_response(Gtk.ResponseType.CANCEL)
d.set_keep_above(True)
sys.exit(0 if d.run() == Gtk.ResponseType.ACCEPT else 1)
PY
        return
    fi
    return 1
}

# Message clair pour un programme qui n'a pas pu démarrer, d'après le journal.
explain_failure() {
    name=$1; status=$2; journal=$3
    missing=$(sed -n 's/.*DLL introuvable : \([^ ]*\).*/\1/p' "$journal" 2>/dev/null | head -n 1)
    function=$(sed -n 's/.*fonction introuvable : \([^ ]*\).*/\1/p' "$journal" 2>/dev/null | head -n 1)
    if [ -n "$missing" ]; then
        printf '« %s » ne peut pas encore fonctionner avec Winlux.\nCe programme a besoin du composant Windows %s, que Winlux ne fournit pas encore. Rien n’a été modifié sur votre ordinateur.' "$name" "$missing"
    elif [ -n "$function" ]; then
        printf '« %s » ne peut pas encore fonctionner avec Winlux.\nCe programme utilise une fonction de Windows (%s) que Winlux ne sait pas encore exécuter. Rien n’a été modifié sur votre ordinateur.' "$name" "$function"
    else
        printf '« %s » s’est arrêté de manière inattendue (code %s).\nSi le problème se reproduit, Paramètres > Signaler un problème permet d’en envoyer le détail.' "$name" "$status"
    fi
}

# Exécute le programme dans le terminal déjà ouvert puis attend Entrée pour
# laisser le temps de lire la sortie.
run_in_terminal() {
    exe=$1
    shift
    cd "$(dirname -- "$exe")" 2>/dev/null || true
    "$winlux" "$exe" "$@"
    status=$?
    printf '\n[%s s’est terminé avec le code %s]\n' "$(basename -- "$exe")" "$status"
    printf 'Appuyez sur Entrée pour fermer cette fenêtre.'
    read -r _ || true
    exit "$status"
}

# Ouvre un émulateur de terminal disponible en lui passant chaque argument
# séparément, sans passer par un shell : les chemins avec espaces restent intacts.
open_terminal() {
    if [ -n "${WINLUX_TERMINAL:-}" ]; then
        exec "$WINLUX_TERMINAL" -e "$@"
    fi
    if command -v winlux-terminal >/dev/null 2>&1; then
        exec winlux-terminal -e "$@"
    fi
    case "${XDG_CURRENT_DESKTOP:-}" in
        *KDE*) order="konsole gnome-terminal kgx xfce4-terminal x-terminal-emulator xterm" ;;
        *XFCE*) order="xfce4-terminal konsole gnome-terminal kgx x-terminal-emulator xterm" ;;
        *) order="gnome-terminal kgx konsole xfce4-terminal x-terminal-emulator xterm" ;;
    esac
    for term in $order; do
        command -v "$term" >/dev/null 2>&1 || continue
        case "$term" in
            gnome-terminal|kgx) exec "$term" -- "$@" ;;
            xfce4-terminal) exec "$term" -x "$@" ;;
            *) exec "$term" -e "$@" ;;
        esac
    done
    return 1
}

# Décode les séquences %XX d'une URI file:// (octet par octet, en sh POSIX).
uri_decode() {
    rest=$1
    out=
    while [ -n "$rest" ]; do
        case "$rest" in
            %[0-9A-Fa-f][0-9A-Fa-f]*)
                hex=${rest#%}
                hex=${hex%"${hex#??}"}
                out="$out$(printf "\\$(printf '%03o' "0x$hex")")"
                rest=${rest#%??}
                ;;
            *)
                char=${rest%"${rest#?}"}
                out="$out$char"
                rest=${rest#?}
                ;;
        esac
    done
    printf '%s' "$out"
}

if [ "${1:-}" = "--in-terminal" ]; then
    shift
    run_in_terminal "$@"
fi

if [ $# -lt 1 ]; then
    show_error "Aucun fichier à ouvrir."
    exit 2
fi

exe=$1
shift
case "$exe" in
    file://*)
        exe=$(uri_decode "${exe#file://}")
        ;;
esac
case "$exe" in
    /*) ;;
    *) exe="$(pwd)/$exe" ;;
esac

if ! command -v "$winlux" >/dev/null 2>&1; then
    show_error "Le runtime Winlux est introuvable ($winlux). Réinstallez Winlux."
    exit 127
fi
if [ ! -e "$exe" ]; then
    show_error "Le fichier « $exe » n’existe pas."
    exit 1
fi
if [ ! -r "$exe" ]; then
    show_error "Le fichier « $(basename -- "$exe") » n’est pas lisible : vérifiez ses permissions."
    exit 1
fi

# Raccourci Windows (.lnk, par exemple sur le Bureau) : on ouvre sa cible
# avec ses arguments, dans le dossier de travail qu'il indique.
case "$exe" in
    *.lnk|*.LNK|*.Lnk)
        if ! resolved=$(winlux-applications resolve-lnk "$exe" 2>&1); then
            show_error "Le raccourci « $(basename -- "$exe") » est illisible.
$resolved"
            exit 1
        fi
        target=$(printf '%s\n' "$resolved" | sed -n 1p)
        workdir=$(printf '%s\n' "$resolved" | sed -n 2p)
        set --
        if [ "$(printf '%s\n' "$resolved" | wc -l)" -gt 2 ]; then
            while IFS= read -r value; do set -- "$@" "$value"; done <<EOF_ARGS
$(printf '%s\n' "$resolved" | sed 1,2d)
EOF_ARGS
        fi
        if [ ! -e "$target" ]; then
            show_error "La cible du raccourci « $(basename -- "$exe") » est introuvable : $target"
            exit 1
        fi
        case "$target" in
            *.exe|*.EXE|*.Exe|*.com|*.COM|*.msi|*.MSI)
                if [ -n "$workdir" ] && [ -d "$workdir" ]; then export WINLUX_WORKDIR="$workdir"; fi
                self=$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")
                exec "$self" "$target" "$@" ;;
        esac
        exec xdg-open "$target"
        ;;
esac

# Nom de l'appli installée, lu dans le journal du runtime (« setup : Claude
# est installé. ») ; à défaut, le nom du fichier de l'installateur.
installed_name() {
    name=$(sed -n 's/^\(setup : \)\{0,1\}\(.*\) est installé\.$/\2/p' "$log" 2>/dev/null | tail -n 1)
    printf '%s' "${name:-$(basename -- "$exe")}"
}

# Assistant d'installation (#833) : au double-clic sur un paquet que le
# runtime reconnaît (.msi, NSIS, Inno Setup), pages d'accueil (dossier,
# raccourci), progression et fin, comme un programme d'installation. Sans
# session graphique, ou avec des arguments explicites (/S, /qn…),
# l'installation reste silencieuse. Rend 1 si l'assistant ne s'applique pas.
run_wizard() {
    [ "$#" -eq 0 ] || return 1
    wizard=
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && wizard=$(command -v winlux-setup-wizard 2>/dev/null)
    if [ -z "$wizard" ]; then
        # Sans assistant, un contrat de licence ne peut pas être accepté :
        # rien n'est installé (#2123). /S, /qn… restent possibles.
        if "$winlux" --setup --license "$exe" >/dev/null 2>&1; then
            show_error "« $(basename -- "$exe") » contient un contrat de licence à accepter, mais l'assistant d'installation n'est pas disponible. Rien n'a été installé."
            exit 1602
        fi
        return 1
    fi
    "$winlux" --setup --info "$exe" >/dev/null 2>&1 || return 1
    cd "$(dirname -- "$exe")" 2>/dev/null || true
    mkdir -p "$state" 2>/dev/null || log=/dev/null
    WINLUX_BIN="$winlux" "$wizard" "$exe" >"$log" 2>&1
    status=$?
    if [ "$status" -eq 0 ] || [ "$status" -eq 3010 ]; then
        command -v winlux-applications >/dev/null 2>&1 && winlux-applications refresh >/dev/null 2>&1
        exit 0
    fi
    # L'assistant a déjà affiché l'erreur ou l'utilisateur a annulé (1602).
    exit "$status"
}

# Paquet MSIX ou AppX : installé par le module setup du runtime (#272).
case "$exe" in
    *.msix|*.MSIX|*.Msix|*.appx|*.APPX|*.Appx|*.msixbundle|*.MSIXBUNDLE|*.appxbundle|*.APPXBUNDLE)
        cd "$(dirname -- "$exe")" 2>/dev/null || true
        mkdir -p "$state" 2>/dev/null || log=/dev/null
        "$winlux" --setup "$exe" >"$log" 2>&1
        status=$?
        # Code 3 : éditeur non vérifié (paquet non signé ou chaîne non
        # vérifiée). Rien n'est installé sans un « oui » explicite.
        if [ "$status" -eq 3 ]; then
            reason=$(sed -n 's/^setup : //p' "$log" 2>/dev/null | tail -n 1)
            if confirm_unverified "$(basename -- "$exe")" "$reason"; then
                "$winlux" --setup --allow-unverified "$exe" >"$log" 2>&1
                status=$?
            else
                exit 3
            fi
        fi
        if [ "$status" -eq 0 ]; then
            command -v winlux-applications >/dev/null 2>&1 && winlux-applications refresh >/dev/null 2>&1
            show_message "« $(installed_name) » est installé." info
        else
            refused_by_anticheat && exit "$status"
            show_error "Installation de « $(basename -- "$exe") » impossible (code $status).
$(tail -n 5 "$log" 2>/dev/null)"
        fi
        exit "$status"
        ;;
esac

# Paquet Windows Installer : le msiexec intégré au runtime l'installe.
case "$exe" in
    *.msi|*.MSI|*.Msi)
        run_wizard "$@" || true
        cd "$(dirname -- "$exe")" 2>/dev/null || true
        mkdir -p "$state" 2>/dev/null || log=/dev/null
        "$winlux" --msiexec /i "$exe" /qb "$@" >"$log" 2>&1
        status=$?
        if [ "$status" -eq 0 ]; then
            command -v winlux-applications >/dev/null 2>&1 && winlux-applications refresh >/dev/null 2>&1
            show_message "« $(installed_name) » est installé." info
        else
            refused_by_anticheat && exit "$status"
            show_error "Installation de « $(basename -- "$exe") » impossible (code $status).
$(tail -n 5 "$log" 2>/dev/null)"
        fi
        exit "$status"
        ;;
esac

reason=$("$winlux" --inspect "$exe" 2>&1 >/dev/null)
kind=$("$winlux" --inspect "$exe" 2>/dev/null)
if [ -z "$kind" ]; then
    case "$reason" in
        *"32 bits"*)
            show_error "« $(basename -- "$exe") » est un programme Windows 32 bits.
Winlux lance déjà les programmes 32 bits simples, mais celui-ci est d’une forme qu’il ne sait pas encore lancer. La version 64 bits de l’éditeur (souvent une archive .zip « portable »), si elle existe, peut fonctionner. Rien n’a été modifié sur votre ordinateur." "$reason" ;;
        *)
            show_error "Impossible d’ouvrir « $(basename -- "$exe") ».
Ce fichier n’est pas un programme Windows que Winlux sait lancer." "${reason:-format inconnu}" ;;
    esac
    exit 1
fi
# Installateur (WiX Burn comme vc_redist, NSIS, Inno Setup) ou désinstalleur
# connu : déroulé par le runtime sans exécuter son code, même en 32 bits.
case "$kind" in
    setup|uninstall)
        [ "$kind" = uninstall ] || run_wizard "$@" || true
        cd "$(dirname -- "$exe")" 2>/dev/null || true
        mkdir -p "$state" 2>/dev/null || log=/dev/null
        "$winlux" "$exe" "$@" >"$log" 2>&1
        status=$?
        # Code 4 : installeur web, téléchargement à accepter (#896).
        if [ "$status" -eq 4 ] && [ "$kind" = setup ]; then
            if confirm_download "$log"; then
                "$winlux" --setup --allow-download "$exe" "$@" >"$log" 2>&1
                status=$?
            else
                exit 4
            fi
        fi
        if [ "$status" -eq 0 ] || [ "$status" -eq 3010 ]; then
            command -v winlux-applications >/dev/null 2>&1 && winlux-applications refresh >/dev/null 2>&1
            if [ "$kind" = uninstall ]; then
                show_message "Le programme est désinstallé." info
            else
                show_message "« $(installed_name) » est installé." info
            fi
            exit 0
        fi
        if [ "$kind" = uninstall ]; then what="Désinstallation"; else what="Installation de « $(basename -- "$exe") »"; fi
        refused_by_anticheat && exit "$status"
        show_error "$what impossible (code $status).
$(tail -n 5 "$log" 2>/dev/null)"
        exit "$status"
        ;;
esac

if command -v winlux-applications >/dev/null 2>&1; then
    winlux-applications register "$exe" >/dev/null 2>&1 || true
fi

if [ "$kind" = console ] && [ -z "${WINLUX_NO_TERMINAL:-}" ] && { [ "${WINLUX_DESKTOP_LAUNCH:-0}" = 1 ] || [ ! -t 1 ]; }; then
    self=$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")
    open_terminal "$self" --in-terminal "$exe" "$@"
    # A missing terminal must not prevent a compatible batch/GUI-test PE from
    # starting. Interactive console applications still need a terminal.
    mkdir -p "$state" 2>/dev/null || log=/dev/null
    cd "$(dirname -- "$exe")" 2>/dev/null || true
    "$winlux" "$exe" "$@" </dev/null >"$log" 2>&1
    status=$?
    summary=$(tail -c 2048 "$log" 2>/dev/null)
    mode=error; if [ "$status" -eq 0 ]; then mode=info; fi
    show_message "« $(basename -- "$exe") » : code $status. Aucun terminal disponible ; sortie enregistrée dans $log.
$summary" "$mode"
    exit "$status"
fi

# Programme graphique (ou console lancée depuis un terminal) : le dossier du
# programme devient le répertoire courant, comme dans l'explorateur Windows,
# sauf si un raccourci .lnk en indique un autre.
mkdir -p "$state" 2>/dev/null || log=/dev/null
cd "${WINLUX_WORKDIR:-$(dirname -- "$exe")}" 2>/dev/null || cd "$(dirname -- "$exe")" 2>/dev/null || true
if [ "$kind" = console ]; then
    exec "$winlux" "$exe" "$@"
fi
started=$(date +%s)
# Code de sortie Windows complet (#1205) : le statut Linux n'en garde que
# l'octet de poids faible (0x780148E0 devenait « code 224 »). Le runtime
# l'écrit ici en hexadécimal, sans le transmettre aux programmes qu'il lance.
exit_file=$(mktemp "${TMPDIR:-/tmp}/winlux-code.XXXXXX" 2>/dev/null) || exit_file=
WINLUX_EXIT_CODE_FILE=$exit_file "$winlux" "$exe" "$@" 2>"$log"
status=$?
code=$status
if [ -n "$exit_file" ]; then
    full=$(head -c 16 "$exit_file" 2>/dev/null)
    case $full in 0x[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]) code=$full ;; esac
    rm -f "$exit_file"
fi
# 0x100, 0x200… : statut Linux 0, mais échec pour Windows.
if [ "$status" -eq 0 ] && [ "$code" != 0 ] && [ "$code" != 0x00000000 ]; then status=1; fi
# Arrêt demandé (SIGHUP, SIGINT, SIGTERM : fermeture de session, kill,
# Ctrl+C) : 128 + numéro du signal, sans code Windows écrit par le runtime.
# Ce n'est pas un plantage, rien à afficher (#1490).
case $status:$code in 129:129|130:130|143:143) exit "$status" ;; esac
if [ "$status" -ne 0 ]; then
    # Un plantage enregistré depuis le lancement : la boîte « Signaler un
    # problème » explique la cause et propose l'envoi (jamais automatique).
    # Seul le bureau PE (gui_demo.exe, WINLUX_DESKTOP_DEMO) affiche lui-même
    # l'écran bleu puis cette boîte. L'Explorateur et les autres applications
    # PE de la session native (WINLUX_NATIVE_SHELL) passent aussi par
    # ShellExecute (WINLUX_DESKTOP_LAUNCH=1) mais n'affichent rien : sans la
    # boîte ici, un .exe graphique qui plantait disparaissait sans un mot.
    pe_desktop=0
    if [ -n "${WINLUX_DESKTOP_DEMO:-}" ] && [ -z "${WINLUX_NATIVE_SHELL:-}" ]; then pe_desktop=1; fi
    if [ "$pe_desktop" != 1 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] \
        && command -v winlux-report >/dev/null 2>&1; then
        winlux-report --crash --since "$started"
        case $? in 0) exit "$status" ;; esac
    fi
    journal=${WINLUX_JOURNAL_DIR:-}
    if [ -z "$journal" ]; then
        # Journal du compte (#633).
        if [ "$(id -u)" = 0 ]; then journal=/run/winlux/journal; else journal=/run/winlux/journal-$(id -u); fi
    fi
    crashes=$journal/crash.log
    [ "$pe_desktop" = 1 ] && [ -e "$crashes" ] \
        && [ "$(sed -n 's/^\[CRASH\] ts=\([0-9]*\).*/\1/p' "$crashes" | tail -n 1)" -ge "$started" ] 2>/dev/null \
        && exit "$status"
    detail=$(tail -n 5 "$log" 2>/dev/null)
    refused_by_anticheat && exit "$status"
    show_error "$(explain_failure "$(basename -- "$exe")" "$code" "$log")" "$detail"
fi
exit "$status"
