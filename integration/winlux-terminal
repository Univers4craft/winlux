#!/bin/sh
# Common terminal entry point; arguments remain separate, including -e commands.
set -eu
terminal=${WINLUX_XTERM:-/usr/bin/xterm}
if ! test -x "$terminal"; then
    echo 'Terminal Winlux absent : installez la mise à jour système complète.' >&2
    exit 127
fi
if test "${1:-}" = --cwd; then
    test "$#" -ge 2 || { echo 'Usage : winlux-terminal [--cwd dossier] [-e commande ...]' >&2; exit 2; }
    cd -- "$2"
    shift 2
fi
# bashrc Winlux : celui d'Ubuntu et de l'utilisateur, plus « su » qui passe
# par sudo quand root est verrouillé (winlux-su.sh).
rcfile=/usr/share/winlux/native/shell/bashrc
if test "$#" = 0; then
    if test -r "$rcfile"; then set -- -e /bin/bash --rcfile "$rcfile" -i; else set -- -e /bin/bash -i; fi
fi
# Ubuntu's bashrc renames xterm windows (user@host: dir); keep the app name.
# Presse-papiers comme sous Windows : Ctrl+Maj+V, Maj+Inser et clic droit
# collent ce qui a été copié (CLIPBOARD) depuis Edge, un .txt ou un .exe ;
# xterm ne collait que la sélection PRIMARY (clic du milieu). Ctrl+Maj+C
# copie la sélection.
paste='#override \n Shift Ctrl <Key>V: insert-selection(CLIPBOARD) \n Shift Ctrl <Key>C: copy-selection(CLIPBOARD) \n Shift <Key>Insert: insert-selection(CLIPBOARD) \n <Btn3Down>: insert-selection(CLIPBOARD)'
exec "$terminal" -title 'Terminal Winlux' -xrm 'XTerm*allowTitleOps: false' -xrm "XTerm*VT100.translations: $paste" -tn xterm-256color -fa 'DejaVu Sans Mono' -fs 11 \
    -u8 -bg '#171325' -fg '#eeeaf8' -cr '#ba9cff' \
    -sb -rightbar -sl 5000 -geometry 100x28 "$@"
