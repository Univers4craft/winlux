<?xml version="1.0" encoding="UTF-8"?>
<!-- Types Winlux (programmes Windows) et traductions fr/de/es des types
     courants que shared-mime-info ne traduit pas ou plus (#591) : Thunar et
     le bureau affichent ces libellés dans la langue de la session. Les
     commentaires s'ajoutent à ceux de freedesktop.org.xml (fusion par
     update-mime-database) ; vérifié par scripts/test-mime-translations.py. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ms-dos-executable">
    <comment>Windows program</comment>
    <comment xml:lang="fr">Programme Windows</comment>
    <comment xml:lang="de">Windows-Programm</comment>
    <comment xml:lang="es">Programa de Windows</comment>
    <glob pattern="*.exe"/>
    <magic priority="80">
      <match type="string" offset="0" value="MZ"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-ms-shortcut">
    <comment>Windows shortcut</comment>
    <comment xml:lang="fr">Raccourci Windows</comment>
    <comment xml:lang="de">Windows-Verknüpfung</comment>
    <comment xml:lang="es">Acceso directo de Windows</comment>
    <glob pattern="*.lnk"/>
    <magic priority="60">
      <match type="string" offset="0" value="L\0\0\0"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-msi">
    <comment>Windows Installer package</comment>
    <comment xml:lang="fr">Paquet Windows Installer</comment>
    <comment xml:lang="de">Windows-Installer-Paket</comment>
    <comment xml:lang="es">Paquete de Windows Installer</comment>
    <glob pattern="*.msi"/>
  </mime-type>
  <mime-type type="application/msix">
    <comment>Windows app package (MSIX)</comment>
    <comment xml:lang="fr">Paquet d&apos;application Windows (MSIX)</comment>
    <comment xml:lang="de">Windows-App-Paket (MSIX)</comment>
    <comment xml:lang="es">Paquete de aplicación de Windows (MSIX)</comment>
    <glob pattern="*.msix"/>
    <glob pattern="*.appx"/>
  </mime-type>
  <mime-type type="application/msixbundle">
    <comment>Windows app package bundle (MSIX)</comment>
    <comment xml:lang="fr">Ensemble de paquets d&apos;application Windows (MSIX)</comment>
    <comment xml:lang="de">Windows-App-Paketbündel (MSIX)</comment>
    <comment xml:lang="es">Conjunto de paquetes de aplicación de Windows (MSIX)</comment>
    <glob pattern="*.msixbundle"/>
    <glob pattern="*.appxbundle"/>
  </mime-type>
