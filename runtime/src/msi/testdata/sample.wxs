<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="{6A1B5C0E-1111-4222-8333-944455556666}" Name="Winlux Exemple" Language="1036" Codepage="1252"
           Version="1.2.3" Manufacturer="Équipe Winlux" UpgradeCode="{0F0E0D0C-AAAA-4BBB-8CCC-DDDDEEEEFFFF}">
    <Package InstallerVersion="200" Compressed="yes" Description="Paquet de test"/>
    <Media Id="1" Cabinet="donnees.cab" EmbedCab="yes"/>
    <Property Id="ALLUSERS" Value="1"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Winlux Exemple">
          <Component Id="Principal" Guid="{11111111-2222-4333-8444-555555555555}" Win64="yes">
            <File Id="app.exe" Name="app.exe" Source="app.exe" KeyPath="yes"/>
            <File Id="lisezmoi" Name="Lisez-moi.txt" Source="lisezmoi.txt"/>
            <File Id="donnees" Name="données.bin" Source="donnees.bin"/>
            <RegistryValue Root="HKLM" Key="Software\Winlux Exemple" Name="Chemin" Type="string" Value="[INSTALLDIR]"/>
            <RegistryValue Root="HKLM" Key="Software\Winlux Exemple" Name="Niveau" Type="integer" Value="7"/>
          </Component>
          <Component Id="Optionnel" Guid="{22222222-2222-4333-8444-555555555555}" Win64="yes">
            <File Id="option" Name="option.txt" Source="lisezmoi.txt"/>
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MenuDir" Name="Winlux Exemple">
          <Component Id="Menu" Guid="{33333333-2222-4333-8444-555555555555}">
            <Shortcut Id="raccourci" Name="Winlux Exemple" Target="[INSTALLDIR]app.exe" WorkingDirectory="INSTALLDIR" Arguments="--demo"/>
            <RemoveFolder Id="MenuDir" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\Winlux Exemple" Name="menu" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Tout" Level="1">
      <ComponentRef Id="Principal"/>
      <ComponentRef Id="Menu"/>
    </Feature>
    <Feature Id="Extra" Level="2">
      <ComponentRef Id="Optionnel"/>
    </Feature>
  </Product>
</Wix>
