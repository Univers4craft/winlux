#!/bin/sh
# Xsession script for Winlux desktop — launched by a display manager (GDM,
# LightDM, SDDM…) when the user selects "Winlux Desktop".
#
# Reads /etc/winlux/preferences.conf for taskbar alignment, theme, etc.
# and starts the Winlux shell (gui_demo.exe) with the runtime.
set -eu

export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export HOME="${HOME:-$(eval echo ~$(whoami))}"

conf=/etc/winlux/preferences.conf
if test -r "$conf"; then
    taskbar_align=$(sed -n 's/^TASKBAR_ALIGN=//p' "$conf")
    desktop_theme=$(sed -n 's/^THEME=//p' "$conf")
else
    taskbar_align=left
    desktop_theme=dark
fi

input_conf=/etc/winlux/input.conf
if test -r "$input_conf"; then
    keyboard_layout=$(sed -n 's/^XKB_LAYOUT=//p' "$input_conf")
    case "$keyboard_layout" in fr|us|de|es|it|pt|gb)
        setxkbmap "$keyboard_layout" 2>/dev/null || true ;;
    esac
fi

# UI scale from screen height.
screen_height=$(xrandr --query 2>/dev/null | awk '/\*/ { split($1, s, "x"); print s[2]; exit }')
ui_scale=1
if test "${screen_height:-0}" -ge 2000; then ui_scale=2
elif test "${screen_height:-0}" -ge 1400; then ui_scale=1.5
elif test "${screen_height:-0}" -ge 1000; then ui_scale=1.25
fi

# Battery and network for tray icons.
tray_battery=0
tray_battery_present=0
for capacity in /sys/class/power_supply/BAT*/capacity; do
    if test -r "$capacity"; then tray_battery=$(cat "$capacity"); tray_battery_present=1; break; fi
done
tray_network=0
for state in /sys/class/net/*/operstate; do
    if test -r "$state" && test "$(cat "$state")" = up; then tray_network=1; break; fi
done

gui_demo=$(find /usr/share/winlux/tests /opt/winlux/tests -name gui_demo.exe 2>/dev/null | head -1)
if test -z "$gui_demo"; then
    echo "gui_demo.exe introuvable" >&2
    exit 1
fi

export WINLUX_DESKTOP_DEMO=1
export WINLUX_TASKBAR_ALIGN="$taskbar_align"
export WINLUX_THEME="$desktop_theme"
export WINLUX_UI_SCALE="$ui_scale"
export WINLUX_TRAY_BATTERY="$tray_battery"
export WINLUX_TRAY_BATTERY_PRESENT="$tray_battery_present"
export WINLUX_TRAY_NETWORK="$tray_network"

exec winlux "$gui_demo"
